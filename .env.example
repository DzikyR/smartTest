# Salin ke .env lalu isi.

# PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/smarttest?schema=public"

# NextAuth — buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=""
# URL publik aplikasi (dipakai untuk callback & panduan Safe Exam Browser)
AUTH_URL="http://localhost:3000"

# Jumlah reverse proxy (nginx/Apache/Cloudflare) di depan aplikasi — untuk membaca IP asli
# (batas jaringan ujian, rate limit, log). Produksi WAJIB di belakang reverse proxy.
TRUSTED_PROXY_COUNT="1"

# --- Safe Exam Browser (pengamanan tingkat 2, bawaan UTS/UAS) ---
# Config Key dari SEB Config Tool (tab "Exam"), 64 karakter heksadesimal; pisahkan koma bila lebih dari satu.
# Kosong = verifikasi lemah (hanya User-Agent).
SEB_CONFIG_KEYS=""
# Opsional: URL berkas konfigurasi .seb, agar peserta mendapat tombol "Buka di Safe Exam Browser".
SEB_CONFIG_URL=""

# --- Login dengan Google (opsional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# Kosong = tombol "Masuk dengan Google" tidak tampil. Bisa dibuka/tutup Super Admin di Kontrol Fitur.
# PENTING: isi SEBELUM `npm run build` — izin CSP ke accounts.google.com dibentuk saat build.
# Email Google yang belum terdaftar otomatis dibuatkan akun Peserta (bila pendaftaran mandiri dibuka).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (lupa password) ---
# Tautan reset memakai AUTH_URL di atas (bukan header Host) — wajib diisi URL publik yang benar.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SmartTest <no-reply@kampus.ac.id>"
# Pengembangan/uji: MAIL_TRANSPORT="file" menulis email ke folder .mail-outbox (tidak dikirim).
MAIL_TRANSPORT=""

# Folder berkas jawaban Tugas (di luar public/). Kosong = ./uploads. WAJIB ikut di-backup.
UPLOAD_DIR=""
